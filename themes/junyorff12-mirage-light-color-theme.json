	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#756F64"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#526B18"
			}
		},
		{
			"name": "Regular Expressions and Escape Characters",
			"scope": [
				"string.regexp",
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#267B65"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#76509A"
			}
		},
		{
			"name": "Built-in constants",
			"scope": [
				"constant.language"
			],
			"settings": {
				"foreground": "#76509A"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"variable.parameter.function-call"
			],
			"settings": {
				"foreground": "#3B3A36a3"
			}
		},
		{
			"name": "Member Variable",
			"scope": [
				"variable.member"
			],
			"settings": {
				"foreground": "#B44842"
			}
		},
		{
			"name": "Language variable",
			"scope": [
				"variable.language"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#28748A"
			}
		},
		{
			"name": "Storage",
			"scope": [
				"storage"
			],
			"settings": {
				"foreground": "#A85D12"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword"
			],
			"settings": {
				"foreground": "#A85D12"
			}
		},
		{
			"name": "Operators",
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#B44842"
			}
		},
		{
			"name": "Separators like ; or ,",
			"scope": [
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#3B3A3672"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation.section"
			],
			"settings": {
				"foreground": "#3B3A36a3"
			}
		},
		{
			"name": "Accessor",
			"scope": [
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#B44842"
			}
		},
		{
			"name": "JavaScript/TypeScript interpolation punctuation",
			"scope": [
				"punctuation.definition.template-expression"
			],
			"settings": {
				"foreground": "#A85D12"
			}
		},
		{
			"name": "Ruby interpolation punctuation",
			"scope": [
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#A85D12"
			}
		},
		{
			"name": "Interpolation text",
			"scope": [
				"meta.embedded"
			],
			"settings": {
				"foreground": "#3B3A36a3"
			}
		},
		{
			"name": "Types fixes",
			"scope": [
				"source.java storage.type",
